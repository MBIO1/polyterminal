{
  "name": "Persistent Bot Scanner",
  "description": "Server-side bot scan loop \u2014 runs every 5 minutes regardless of whether the browser is open. Fetches Polymarket order-book depth, checks liquidity, adapts kelly sizing from trade history, and auto-executes qualifying arbitrage signals.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-04-17T17:39:20.794000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "persistent_bot_scanner",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "botRunner",
            "args": {
              "action": "scan"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "botRunner"
  }
}