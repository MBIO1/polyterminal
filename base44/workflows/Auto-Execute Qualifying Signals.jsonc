{
  "name": "Auto-Execute Qualifying Signals",
  "description": "Runs every 5 minutes. Pulls recent ArbSignal rows, checks them against ArbConfig gates (kill switch, bot_running, edge thresholds, drawdown, margin, delta drift), and executes trades. Honors paper_trading flag.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-04-21T12:09:01.945000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_execute_qualifying_signals",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "executeSignals",
            "args": {
              "max_signals": 25,
              "min_confirmed": 1,
              "dry_run": false,
              "signal_ttl_ms": 600000
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "executeSignals"
  }
}