{
  "name": "Auto-Execute Live Trades",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.mode == \"live\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "BotTrade"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_execute_live_trades",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoExecuteTradeOrder",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoExecuteTradeOrder"
  }
}