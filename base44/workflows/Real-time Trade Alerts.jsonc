{
  "name": "Real-time Trade Alerts",
  "description": "Send Telegram alerts when trades execute or complete",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "BotTrade"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "real_time_trade_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyTradeExecution",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyTradeExecution"
  }
}