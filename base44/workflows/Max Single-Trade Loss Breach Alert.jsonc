{
  "name": "Max Single-Trade Loss Breach Alert",
  "description": "Fires a Critical Slack + Telegram alert and logs an ArbException whenever an ArbTrade closes with a loss exceeding ArbConfig.max_single_trade_loss_pct of total_capital.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"Closed\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ArbTrade"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "max_single_trade_loss_breach_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "singleTradeLossAlert",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "singleTradeLossAlert"
  }
}