{
  "name": "Auto-Restart Bot on Stop",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"bot_running\") != null) and (.trigger.data.bot_running == false)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "BotConfig"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_restart_bot_on_stop",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoRestartBot",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoRestartBot"
  }
}